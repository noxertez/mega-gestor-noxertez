RewriteEngine On

# Ignore existing files and directories (important for CSS/JS/images)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Rewrite everything to pages/ (supports nested folders)
# Only rewrite if it's not already a .php file
RewriteCond %{REQUEST_URI} !\.php$
RewriteRule ^(.+)$ pages/$1.php [L]
